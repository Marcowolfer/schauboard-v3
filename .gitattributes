# Default: treat as text, normalize to LF in repo + working copy
* text=auto eol=lf

# Source / scripts (LF — run on Linux servers)
*.sh    text eol=lf
*.py    text eol=lf
*.php   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.htm   text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.sql   text eol=lf
*.po    text eol=lf
